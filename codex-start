#!/usr/bin/env python3
"""Executable entry point for codex-start."""

from pathlib import Path
import sys


# Resolve symlinks so a ~/bin/codex-start link can still import the project.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from codex_start import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
